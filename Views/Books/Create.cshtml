@model BookCreateViewModel

@{
    ViewData["Title"] = "Thêm sách";
}

<div class="mb-4">
    <div class="text-muted small mb-1">Danh mục / Sách</div>
    <h1 class="page-title mb-1">Thêm sách mới</h1>
    <p class="text-muted mb-0">Nhập thông tin cơ bản của sách để đưa vào danh mục.</p>
</div>

<form asp-action="Create" method="post" class="card">
    @Html.AntiForgeryToken()
    <div class="card-header">
        <h2 class="h6 mb-0">Thông tin sách</h2>
    </div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-12">
                <label asp-for="BookTitle" class="form-label"></label>
                <input asp-for="BookTitle" class="form-control" />
                <span asp-validation-for="BookTitle" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ISBN" class="form-label"></label>
                <input asp-for="ISBN" class="form-control" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SalePrice" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="SalePrice" type="number" min="0" step="1" class="form-control" />
                    <span class="input-group-text">₫</span>
                </div>
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
        <div class="form-text mt-3">Mã sách (SKU) sẽ được hệ thống tự động sinh khi lưu.</div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">
            Lưu sách
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
