@model BookSalesCore.ViewModels.BookEditViewModel

@{
    ViewData["Title"] = "Sửa thông tin sách";
}

<div class="mb-4">
    <div class="text-muted small mb-1">Danh mục / Sách</div>
    <h1 class="page-title mb-1">Sửa thông tin sách</h1>
    <p class="text-muted mb-0">Cập nhật giá bán, thông tin mô tả và trạng thái kinh doanh.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.BookId" method="post" class="card">
    @Html.AntiForgeryToken()
    <input asp-for="BookId" type="hidden" />
    <div class="card-header">
        <h2 class="h6 mb-0">Thông tin sách</h2>
    </div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Mã sách (SKU)</label>
                <input value="@ViewData["SKU"]" class="form-control" readonly />
                <div class="form-text">Mã sách được hệ thống quản lý và không thể thay đổi.</div>
            </div>
            <div class="col-md-6">
                <label asp-for="BookTitle" class="form-label"></label>
                <input asp-for="BookTitle" class="form-control" />
                <span asp-validation-for="BookTitle" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ISBN" class="form-label"></label>
                <input asp-for="ISBN" class="form-control" />
                <span asp-validation-for="ISBN" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
                <span asp-validation-for="CategoryName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SalePrice" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="SalePrice" type="number" min="0" step="1" class="form-control" />
                    <span class="input-group-text">₫</span>
                </div>
                <span asp-validation-for="SalePrice" class="text-danger"></span>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check mb-2">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label"></label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">
            Lưu thay đổi
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
