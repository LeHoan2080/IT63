@model CustomerEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
}

<div class="mb-4">
    <div class="text-muted small mb-1">Danh bạ / Khách hàng</div>
    <h1 class="page-title mb-1">Chỉnh sửa khách hàng</h1>
    <p class="text-muted mb-0">Cập nhật thông tin khách hàng.</p>
</div>

<form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post" class="card">
    @Html.AntiForgeryToken()
    <input asp-for="CustomerId" type="hidden" />
    <div class="card-header">
        <h2 class="h6 mb-0">Thông tin khách hàng</h2>
    </div>
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="CustomerCode" class="form-label"></label>
            <input asp-for="CustomerCode" class="form-control" readonly />
            <div class="form-text">Mã khách hàng do hệ thống cấp và không thể chỉnh sửa.</div>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Address" class="form-label"></label>
            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>

        @if (User.IsInRole("Administrator"))
        {
            <div class="form-check mt-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        }
        else
        {
            <input asp-for="IsActive" type="hidden" />
            <div class="text-muted small mt-3">
                Trạng thái khách hàng hiện tại:
                @(Model.IsActive ? "Đang hoạt động" : "Ngừng hoạt động")
            </div>
        }
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}